    "pseudo_bounds_reported": [
      "encoder_response",
      "correct_h1_response",
      "action_zero_h5_response",
      "candidate_shuffle_h5_response",
      "time_shuffle_h5_response"
    ],
    "report_tightness": ["mean_slack", "utilization_quantiles", "maximum_violation"]
  },
  "pusht_replay_gate": {
    "hidden_state_recovery": "replay dense episode prefix, preserve recovered block velocity, snap exact visible current state",
    "maximum_state_l2_error": 0.01,
