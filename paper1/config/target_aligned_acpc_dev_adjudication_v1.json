  "planner_query": {
    "observation_steps": 1,
    "plan_horizon": 5,
    "action_block": 5,
    "goal_offset_low_level_steps": 25,
    "goal_index_rule": "current_index + plan_horizon * action_block / frameskip",
    "candidate_pool": "actual CEM step-zero ordered proposal",
