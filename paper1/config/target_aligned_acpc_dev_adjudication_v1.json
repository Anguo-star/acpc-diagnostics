    "grouped_cv": "leave-one-trajectory-block-out",
    "ridge_alpha": 1.0
  },
  "candidate_targets": {
    "signed_secondary": "probe_h5_error - nominal_h5_error",
    "adverse_primary_harm": "max(probe_h5_error - nominal_h5_error, 0)",
    "absolute_certificate_target": "abs(probe_h5_error - nominal_h5_error)",
    "true_future": "same-state simulator-rendered candidate future",
    "same_metric": "canonical uniform weighted-stacked L2"
  },
  "logged_targets": {
    "support": "recorded dataset actions only",
